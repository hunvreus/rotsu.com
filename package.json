    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  }
}
